// (fix193) The dll's version information (Windows shows it in the file's properties): it tells an installer, or a person, that this
// dxgi.dll is Starfield2VR and which game version it was built for (SFVR_GAME_1_16_244 in CMakeLists.txt: 1.16.244, else 1.16.236).
#include <winver.h>

#define SFVR_FILE_VERSION     1,0,0,200
#define SFVR_FILE_VERSION_STR "1.0.0.200"

#ifdef SFVR_GAME_1_16_244
#define SFVR_GAME_STR "1.16.244"
#else
#define SFVR_GAME_STR "1.16.236"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SFVR_FILE_VERSION
 PRODUCTVERSION SFVR_FILE_VERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Starfield2VR"
            VALUE "FileDescription",  "Starfield2VR, a VR mod, for Starfield " SFVR_GAME_STR
            VALUE "FileVersion",      SFVR_FILE_VERSION_STR
            VALUE "InternalName",     "Starfield2VR"
            VALUE "LegalCopyright",   "Copyright (c) 2026 starfield2vr contributors. MIT License."
            VALUE "OriginalFilename", "dxgi.dll"
            VALUE "ProductName",      "Starfield2VR"
            VALUE "ProductVersion",   SFVR_FILE_VERSION_STR
            VALUE "Comments",         "For Starfield " SFVR_GAME_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
